<Page
    x:Class="BrowserClient.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BrowserClient"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource PageBgBrush}"
    RequestedTheme="Default"
    SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <Style x:Key="ChromeIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource IconBrush}"/>
        </Style>

        <Style x:Key="ConnectPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource ConnectAccentBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource ConnectPrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ConnectSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource ConnectFieldBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource ConnectSecondaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
    </Page.Resources>

    <Grid Name="mainGrid" SizeChanged="MainGrid_SizeChanged" Background="{ThemeResource PageBgBrush}">

        <Grid Name="browser" SizeChanged="Browser_SizeChanged" Background="{ThemeResource PageBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top chrome: single address bar -->
            <Grid Grid.Row="0" Name="ChromeGrid" Background="{ThemeResource ChromeBgBrush}">
                <Grid Name="NavbarGrid" Margin="2,4,2,4" MinHeight="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Name="NavigateBack"
                            Grid.Column="0"
                            Style="{StaticResource ChromeIconButtonStyle}"
                            Click="NavigateBack_Click"
                            ToolTipService.ToolTip="Back">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72B;" FontSize="18" Foreground="{ThemeResource IconBrush}"/>
                    </Button>

                    <Button Name="NavigateForward"
                            Grid.Column="1"
                            Style="{StaticResource ChromeIconButtonStyle}"
                            Click="NavigateForward_Click"
                            ToolTipService.ToolTip="Forward">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72A;" FontSize="18" Foreground="{ThemeResource IconBrush}"/>
                    </Button>

                    <Border Grid.Column="2"
                            Background="{ThemeResource PillBrush}"
                            CornerRadius="14"
                            MinHeight="0"
                            Height="28"
                            Margin="4,2"
                            VerticalAlignment="Center">
                        <TextBox Name="urlField"
                                 PlaceholderText="Search or enter address"
                                 KeyDown="TextBox_KeyDown"
                                 TextChanged="UrlField_TextChanged"
                                 GotFocus="UrlField_GotFocus"
                                 LostFocus="UrlField_LostFocus"
                                 IsTextPredictionEnabled="False"
                                 InputScope="Url"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{ThemeResource IconBrush}"
                                 Padding="10,0"
                                 Margin="0"
                                 MinHeight="0"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 HorizontalAlignment="Stretch"/>
                    </Border>

                    <Button Name="TabsButton"
                            Grid.Column="3"
                            Style="{StaticResource ChromeIconButtonStyle}"
                            Click="TabsButton_Click"
                            ToolTipService.ToolTip="Tabs">
                        <Grid Width="20" Height="20">
                            <Border BorderBrush="{ThemeResource IconBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="3"
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <TextBlock Name="TabCountText"
                                       Text="1"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource IconBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Name="MoreButton"
                            Grid.Column="4"
                            Style="{StaticResource ChromeIconButtonStyle}"
                            ToolTipService.ToolTip="More">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE712;" FontSize="18" Foreground="{ThemeResource IconBrush}"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Name="HistoryMenuButton"
                                                Text="History"
                                                Click="HistoryMenu_Click"/>
                                <MenuFlyoutItem Name="DownloadsMenuButton"
                                                Text="Downloads"
                                                Click="DownloadsMenu_Click"/>
                                <MenuFlyoutItem Name="AddToHomeButton"
                                                Text="Add to Home"
                                                Click="AddToHome_Click"/>
                                <MenuFlyoutItem Name="AboutButton"
                                                Text="About"
                                                Click="About_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <Rectangle Height="1"
                           VerticalAlignment="Bottom"
                           Fill="{ThemeResource ChromeLineBrush}"/>
            </Grid>

            <!-- Page stream -->
            <Grid Grid.Row="1" Background="Black">
                <Image Name="test"
                       Stretch="Fill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       ManipulationMode="None"
                       PointerPressed="Test_PointerPressed"
                       PointerReleased="Test_PointerReleased"
                       PointerMoved="Test_PointerMoved"
                       PointerCanceled="Test_PointerCanceled"
                       PointerCaptureLost="Test_PointerCaptureLost"/>

                <!-- Hidden sink required for MediaCapture.StartPreviewAsync on WM10 -->
                <CaptureElement Name="MediaPreviewSink"
                                Width="1"
                                Height="1"
                                Opacity="0"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"/>

                <Rectangle Name="ScaleRect"/>

                <!-- Chrome-style URL suggestions -->
                <Border Name="UrlSuggestPanel"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Margin="8,4,8,0"
                        Padding="0,4"
                        CornerRadius="8"
                        Background="{ThemeResource TabInactiveBrush}"
                        BorderBrush="{ThemeResource ChromeLineBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed"
                        Canvas.ZIndex="80">
                    <StackPanel Name="UrlSuggestStrip" Orientation="Vertical"/>
                </Border>

                <TextBox x:Name="KeyboardCaptureBox"
                         Opacity="0.02"
                         Height="36"
                         Margin="0"
                         Padding="0"
                         BorderThickness="0"
                         Background="Transparent"
                         AcceptsReturn="False"
                         TextWrapping="NoWrap"
                         IsTextPredictionEnabled="True"
                         IsHitTestVisible="False"
                         VerticalAlignment="Bottom"
                         HorizontalAlignment="Stretch"
                         TextChanging="KeyboardCaptureBox_TextChanging"
                         KeyDown="KeyboardCaptureBox_KeyDown"
                         LostFocus="KeyboardCaptureBox_LostFocus"/>
            </Grid>

            <TextBox Visibility="Collapsed"
                     Name="urlBar"
                     PlaceholderText="Search or enter address"
                     KeyDown="TextBox_KeyDown"
                     IsTextPredictionEnabled="False"
                     InputScope="Url"/>

            <Grid Name="TextInput" Visibility="Collapsed" VerticalAlignment="Bottom" Background="{ThemeResource ChromeBgBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="websiteTextBox"
                         Grid.Column="0"
                         PlaceholderText="Type here"
                         Margin="12,8"
                         KeyDown="WebsiteTextBox_KeyDown"
                         BorderThickness="0"
                         Background="{ThemeResource PillBrush}"
                         Foreground="{ThemeResource IconBrush}"
                         Padding="12,10"/>
                <Button Visibility="Collapsed"
                        Name="SendText"
                        Grid.Column="1"
                        Style="{StaticResource ChromeIconButtonStyle}"
                        Margin="0,0,8,0"
                        Click="SendText_Click">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE724;" FontSize="16"/>
                </Button>
            </Grid>

            <Grid Name="TabsOverlay"
                  Grid.RowSpan="2"
                  Visibility="Collapsed"
                  Background="{ThemeResource TabsOverlayBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="8,8,8,4" MinHeight="48">
                    <TextBlock Text="Tabs"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource IconBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                    <Button Name="CloseTabsButton"
                            Style="{StaticResource ChromeIconButtonStyle}"
                            HorizontalAlignment="Right"
                            Click="CloseTabsButton_Click"
                            ToolTipService.ToolTip="Close">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="16" Foreground="{ThemeResource IconBrush}"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="12,4">
                    <StackPanel Name="TabStripPanel" Orientation="Vertical"/>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="12,8,12,12">
                    <Button Name="NewTabButton"
                            HorizontalAlignment="Stretch"
                            Height="44"
                            BorderThickness="0"
                            Background="{ThemeResource PillBrush}"
                            Foreground="{ThemeResource IconBrush}"
                            FontWeight="SemiBold"
                            Click="NewTab_Click"
                            Content="+ New tab"/>
                </Grid>
            </Grid>

            <Grid Name="HistoryOverlay"
                  Grid.RowSpan="2"
                  Visibility="Collapsed"
                  Background="{ThemeResource TabsOverlayBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="8,8,8,4" MinHeight="48">
                    <TextBlock Text="History"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource IconBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                    <Button Name="CloseHistoryButton"
                            Style="{StaticResource ChromeIconButtonStyle}"
                            HorizontalAlignment="Right"
                            Click="CloseHistoryButton_Click"
                            ToolTipService.ToolTip="Close">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="16" Foreground="{ThemeResource IconBrush}"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="12,4">
                    <StackPanel Name="HistoryStripPanel" Orientation="Vertical"/>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="12,8,12,12">
                    <TextBlock Name="HistoryEmptyText"
                               Text="No history yet"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource MutedBrush}"
                               Visibility="Collapsed"/>
                    <Button Name="ClearHistoryButton"
                            HorizontalAlignment="Stretch"
                            Height="44"
                            BorderThickness="0"
                            Background="{ThemeResource PillBrush}"
                            Foreground="{ThemeResource IconBrush}"
                            FontWeight="SemiBold"
                            Click="ClearHistory_Click"
                            Content="Clear all"/>
                </Grid>
            </Grid>

            <Grid Name="DownloadsOverlay"
                  Grid.RowSpan="2"
                  Visibility="Collapsed"
                  Background="{ThemeResource TabsOverlayBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="8,8,8,4" MinHeight="48">
                    <TextBlock Text="Downloads"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource IconBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                    <Button Name="CloseDownloadsButton"
                            Style="{StaticResource ChromeIconButtonStyle}"
                            HorizontalAlignment="Right"
                            Click="CloseDownloadsButton_Click"
                            ToolTipService.ToolTip="Close">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="16" Foreground="{ThemeResource IconBrush}"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="12,4">
                    <StackPanel Name="DownloadStripPanel" Orientation="Vertical"/>
                </ScrollViewer>

                <TextBlock Grid.Row="2"
                           Name="DownloadsEmptyText"
                           Text="No downloads yet"
                           Margin="16,8,16,16"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource MutedBrush}"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- Auto-dismiss download toast -->
            <Border Name="DownloadToast"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Margin="16,0,16,20"
                    Padding="14,12"
                    CornerRadius="12"
                    Background="{ThemeResource PillBrush}"
                    BorderBrush="{ThemeResource ChromeLineBrush}"
                    BorderThickness="1"
                    Opacity="0"
                    Visibility="Collapsed"
                    Canvas.ZIndex="100">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="DownloadToastMessage"
                               Grid.Column="0"
                               Text="Downloading..."
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource IconBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0"/>
                    <Button Name="DownloadToastDetailsButton"
                            Grid.Column="1"
                            Content="Details"
                            MinWidth="72"
                            Height="32"
                            Padding="12,0"
                            BorderThickness="0"
                            Background="{ThemeResource ConnectAccentBrush}"
                            Foreground="{ThemeResource ConnectPrimaryForegroundBrush}"
                            FontWeight="SemiBold"
                            Click="DownloadToastDetails_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Connect -->
        <Grid Name="ConnectPage" Visibility="Visible" Background="{ThemeResource ConnectBgBrush}">
            <Rectangle Name="connectRect" Fill="{ThemeResource ConnectBgBrush}"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="28,0">
                <TextBlock Text="Browser"
                           FontSize="34"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource IconBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Connect to your PC server"
                           FontSize="14"
                           Foreground="{ThemeResource MutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <Border Background="{ThemeResource ConnectFieldBrush}" CornerRadius="14" Padding="2" Margin="0,0,0,16">
                    <TextBox Name="serverAddress"
                             Text="ws://server:8081"
                             PlaceholderText="ws://server:8081"
                             IsTextPredictionEnabled="False"
                             InputScope="Url"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{ThemeResource IconBrush}"
                             Padding="14,12"
                             FontSize="15"/>
                </Border>

                <Button Name="connectBtn"
                        Content="Connect"
                        Style="{StaticResource ConnectPrimaryButtonStyle}"
                        Click="Button_Click"/>
                <Button Name="discoverBtn"
                        Content="Discover on Wi-Fi"
                        Style="{StaticResource ConnectSecondaryButtonStyle}"
                        Click="DiscoverBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Discovery -->
        <Grid Name="DiscoveryPage" Visibility="Collapsed" Background="{ThemeResource ConnectBgBrush}">
            <Rectangle Name="dicoverRect" Fill="{ThemeResource ConnectBgBrush}"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressRing IsActive="True" Width="40" Height="40" Foreground="{ThemeResource IconBrush}" Margin="0,0,0,16"/>
                <TextBlock Text="Looking for servers…"
                           Foreground="{ThemeResource IconBrush}"
                           FontSize="16"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Keep the PC server running on your network"
                           Foreground="{ThemeResource MutedBrush}"
                           FontSize="12"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
